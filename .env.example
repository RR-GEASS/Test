# Sous-domaine dont l’enregistrement DNS A pointe vers le serveur.
DOMAIN=compta.votre-domaine.fr

# Sauvegarde complète automatique dans le volume sci_backups.
# Ce volume reste sur le serveur : copiez-le aussi vers un autre support.
SCI_BACKUP_INTERVAL_HOURS=24
SCI_BACKUP_KEEP=30
# Pour un lancement hors Docker, dossier de destination des sauvegardes :
# SCI_BACKUP_DIR=/chemin/vers/un-autre-support

# Le premier compte peut être créé ; les suivants nécessitent une invitation.
SCI_REGISTRATION_MODE=closed
